# Sunny AI Companion - Environment Configuration
# Copy this file to .env to configure custom endpoints.
# NOTE: In demo mode, no external API keys or backends are required.
# All data and conversations run locally and securely on your device.

# Optional Backend API URL (for Phase 2 & 3 server integration)
EXPO_PUBLIC_API_URL=https://api.sunnycompanion.app/v1

# App Environment (development, staging, production)
EXPO_PUBLIC_APP_ENV=development

# Feature Flags
EXPO_PUBLIC_ENABLE_DEMO_MODE=true
EXPO_PUBLIC_ENABLE_LOCAL_STORAGE=true
